#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${ROOT_DIR}"

MODULE_DIR="${NHIND_MODULE_DIR:-modules/hello}"
NEW_MODULE_SCRIPT="${ROOT_DIR}/scripts/new-module.sh"
COMPOSE=(docker compose)

module_npm_prefix() {
  if [ "${MODULE_DIR}" = "packages/nostr-client" ]; then
    printf '%s' "packages/nostr-client"
    return
  fi
  printf '%s' "${MODULE_DIR}"
}

usage() {
  cat <<'EOF'
NostrHiveMind dev wrapper (Docker-only host toolchain).

Usage: ./scripts/dev <command> [args...]

Commands:
  up              Start dev + nostr-relay containers in background
  down            Stop containers
  shell           Interactive shell inside dev container
  install         npm ci in module (NHIND_MODULE_DIR, default: modules/hello)
  bundle          Build dist/bundle.js (Acurast deploy artifact)
  run             Run bundle locally with mock _STD_
  test            Run unit tests
  test:integration  Run nostr-relay integration tests (requires ./scripts/dev up)
  preflight-heartbeat <host> [module]
                  Check hello heartbeat on a relay (30090)
  smoke-coordinator <host> [module]
                  Check coordinator registry + scorecard on a relay
  smoke-relay <host> [expected-ip]
                  Check HTTPS, WSS, and Acurast HTTP bridge
  new-module <n>  Scaffold modules/<n> from module-template
  acurast <cmd>   Run acurast CLI in module dir (init, deploy, live, ...)
  npm <args>      Run npm in module dir
  compose <args>  Pass-through to docker compose

Examples:
  ./scripts/dev up
  NHIND_MODULE_DIR=modules/coordinator ./scripts/dev bundle
  ./scripts/dev run
  ./scripts/dev test
  ./scripts/dev acurast init
  ./scripts/dev acurast deploy
  ./scripts/dev acurast estimate-fee
EOF
}

ensure_image() {
  "${COMPOSE[@]}" build dev >/dev/null
}

run_dev() {
  ensure_image
  "${COMPOSE[@]}" run --rm dev "$@"
}

case "${1:-}" in
  up)
    ensure_image
    "${COMPOSE[@]}" --profile relay up -d dev nostr-relay
    ;;
  down)
    "${COMPOSE[@]}" down
    ;;
  shell)
    run_dev bash
    ;;
  install)
    if [ "${MODULE_DIR}" = "packages/nostr-client" ]; then
      run_dev bash -lc "npm ci --prefix packages/nostr-client && npm run build --prefix packages/nostr-client"
    else
      run_dev bash -lc "npm ci --prefix packages/nostr-client && npm run build --prefix packages/nostr-client && npm ci --prefix ${MODULE_DIR}"
    fi
    ;;
  bundle)
    run_dev npm run bundle --prefix "$(module_npm_prefix)"
    ;;
  run)
    run_dev npm run start:local --prefix "$(module_npm_prefix)"
    ;;
  test)
    run_dev npm test --prefix "$(module_npm_prefix)"
    ;;
  test:integration)
    run_dev npm run test:integration --prefix packages/nostr-client
    ;;
  preflight-heartbeat)
    shift
    bash scripts/preflight-hello-heartbeat.sh "$@"
    ;;
  smoke-coordinator)
    shift
    bash scripts/smoke-coordinator-relay.sh "$@"
    ;;
  smoke-relay)
    shift
    bash infra/nostr-relay/scripts/smoke-relay.sh "$@"
    ;;
  new-module)
    shift
    "${NEW_MODULE_SCRIPT}" "$@"
    ;;
  acurast)
    shift
    run_dev bash -lc "cd ${MODULE_DIR} && acurast $*"
    ;;
  npm)
    shift
    run_dev npm "$@" --prefix "${MODULE_DIR}"
    ;;
  compose)
    shift
    "${COMPOSE[@]}" "$@"
    ;;
  -h|--help|help|"")
    usage
    ;;
  *)
    echo "Unknown command: $1" >&2
    usage >&2
    exit 1
    ;;
esac
