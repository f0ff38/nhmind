{
  "projects": {
    "oracle-feed": {
      "projectName": "oracle-feed",
      "fileUrl": "dist/bundle.js",
      "network": "canary",
      "onlyAttestedDevices": true,
      "enableDevtools": true,
      "assignmentStrategy": {
        "type": "Single"
      },
      "execution": {
        "type": "interval",
        "intervalInMs": 60000,
        "numberOfExecutions": 1440,
        "maxExecutionTimeInMs": 50000
      },
      "maxAllowedStartDelayInMs": 10000,
      "usageLimit": {
        "maxMemory": 0,
        "maxNetworkRequests": 10,
        "maxStorage": 0
      },
      "numberOfReplicas": 1,
      "requiredModules": [],
      "minProcessorReputation": 0,
      "maxCostPerExecution": 5000000000,
      "includeEnvironmentVariables": [
        "RELAY_URL",
        "ORACLE_LIST_PRICE_MSATS",
        "ORACLE_MSAT_TO_ACU_RATE",
        "ORACLE_JOB_LOOKBACK_SEC",
        "ORACLE_MIN_SOURCES"
      ],
      "processorWhitelist": [],
      "mutability": "Mutable"
    }
  }
}
