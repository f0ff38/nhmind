{
  "projects": {
    "template": {
      "projectName": "template",
      "fileUrl": "dist/bundle.js",
      "network": "canary",
      "onlyAttestedDevices": true,
      "enableDevtools": true,
      "startAt": {
        "msFromNow": 300000
      },
      "assignmentStrategy": {
        "type": "Single"
      },
      "execution": {
        "type": "onetime",
        "maxExecutionTimeInMs": 60000
      },
      "maxAllowedStartDelayInMs": 10000,
      "usageLimit": {
        "maxMemory": 0,
        "maxNetworkRequests": 0,
        "maxStorage": 0
      },
      "numberOfReplicas": 1,
      "requiredModules": [],
      "minProcessorReputation": 0,
      "maxCostPerExecution": 5000000000,
      "includeEnvironmentVariables": ["RELAY_URL"],
      "processorWhitelist": [],
      "mutability": "Mutable"
    }
  }
}
